# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Prisma driver adapter reads this directly;
# Prisma Migrate reads it via prisma.config.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/vehicle_tracking

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins, or * for any (dev only)
CORS_ORIGIN=*

# Trip detection
TRIP_START_SPEED_KMH=5
TRIP_END_STOP_MINUTES=5

# Alerts
OVERSPEED_LIMIT_KMH=80
DEVICE_OFFLINE_MINUTES=10
LONG_STOP_MINUTES=15

# GPS point validation: reject a point if it implies a jump of more than
# GPS_MAX_JUMP_METERS within GPS_MAX_JUMP_SECONDS of the previous point.
GPS_MAX_JUMP_METERS=2000
GPS_MAX_JUMP_SECONDS=10

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Minutes ahead of UTC to use when computing "today" for dashboard/report
# stats (e.g. 330 for IST). Trip records themselves are always stored in UTC;
# this only shifts which calendar day a trip near midnight gets counted in.
REPORT_UTC_OFFSET_MINUTES=0

# GPS simulator (npm run gps:simulate) — get these by registering a user,
# creating a vehicle, and registering a device for it. The device token is
# only ever shown once, at registration time.
SIMULATOR_API_URL=http://localhost:3000/api/v1
SIMULATOR_VEHICLE_ID=
SIMULATOR_DEVICE_ID=
SIMULATOR_DEVICE_TOKEN=
SIMULATOR_INTERVAL_MS=5000
